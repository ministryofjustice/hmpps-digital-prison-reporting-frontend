{% from "moj/components/notification-badge/macro.njk" import mojNotificationBadge %}

{% macro dprDashboardInternalAudit(internalAudit, type) %}
  {% set noIssuesFound = internalAudit.totalCount === 0 %}
  {% set ariaId = internalAudit.id + '_audit' %}

  <div
    role="region"
    aria-labelledby="{{ ariaId }}"
    class="dpr-dashboard-audit dpr-dashboard-audit--vis-audit {% if noIssuesFound %} dpr-dashboard-audit--passed{% endif %}">

    <h1 id="{{ ariaId }}" class="govuk-heading-m">Audit for {{ type }} "{{ internalAudit.name or internalAudit.id }}"</h1>

    {% if noIssuesFound %}

      <p class="govuk-body dpr-audit-no-issues">No issues found</p>

    {% else %}

      {% if internalAudit.errorCount %}
        <div
          role="region"
          aria-labelledby="{{ ariaId }}--errors">

          <ul class="govuk-list">
            <h2 id="{{ ariaId }}--errors" class="govuk-heading-s">Errors</h2>
            {% for error in internalAudit.errors %}
              <li>
                <h3 class="govuk-heading-s">{{ error.title }}</h3>
                <p class="dpr-audit-description">{{ error.description }}</p>
              </li>
            {% endfor %}
          </ul>

        </div>
      {% endif %}

      {% if internalAudit.warningCount %}
        <div
          role="region"
          aria-labelledby="{{ ariaId }}--warnings">

          <h2 id="{{ ariaId }}--warnings" class="govuk-heading-s">Warnings</h2>
          <ul class="govuk-list">
            {% for warning in internalAudit.warnings %}
              <li>
                <h3 class="govuk-heading-s">{{ warning.title }}</h3>
                <p class="dpr-audit-description">{{ warning.description }}</p>
              </li>
            {% endfor %}
          </ul>

        </div>
      {% endif %}

      {% if internalAudit.suggestionCount %}
        <div
          role="region"
          aria-labelledby="{{ ariaId }}--suggestions">

          <h2 id="{{ ariaId }}--suggestions" class="govuk-heading-s">Suggestions</h2>
          <ul class="govuk-list">
            {% for suggestion in internalAudit.suggestions %}
              <li>
                <h3 class="govuk-heading-s">{{ suggestion.title }}</h3>
                <p class="dpr-audit-description">{{ suggestion.description }}</p>
              </li>
            {% endfor %}
          </ul>

        </div>
      {% endif %}

      {% if internalAudit.infoCount %}
        <div
          role="region"
          aria-labelledby="{{ ariaId }}--info">

          <h2 id="{{ ariaId }}--info" class="govuk-heading-s">Info</h2>
          <ul class="govuk-list">
            {% for i in internalAudit.info %}
              <li>
                <h3 class="govuk-heading-s">{{ i.title }}</h3>
                <p class="dpr-audit-description">{{ i.description }}</p>
              </li>
            {% endfor %}
          </ul>

        </div>
      {% endif %}

    {% endif %}

  </div>
{% endmacro %}
