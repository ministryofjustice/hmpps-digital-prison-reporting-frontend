{% from "moj/components/notification-badge/macro.njk" import mojNotificationBadge %}

{% macro dprDashboardVisAudit(visualAudit) %}
  {% set noIssuesFound = visualAudit.totalCount === 0 %}

  <div
    class="dpr-dashboard-audit dpr-dashboard-audit--vis-audit {% if noIssuesFound %} dpr-dashboard-audit--passed{% endif %}" id="{{ visualAudit.id }}_audit">

    <h1 class="govuk-heading-m">Audit for chart "{{ visualAudit.name or visualAudit.id }}"</h1>

    {% if noIssuesFound %}

      <p class="govuk-body dpr-audit-no-issues">No issues found</p>

    {% else %}

      {% if visualAudit.errorCount %}
        <ul class="govuk-list">
          <h2 class="govuk-heading-s">Errors</h2>
          {% for error in visualAudit.errors %}
            <li>
              <h3 class="govuk-heading-s">{{ error.title }}</h3>
              <p class="dpr-audit-description">{{ error.description }}</p>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if visualAudit.warningCount %}
        <h2 class="govuk-heading-s">Warnings</h2>
        <ul class="govuk-list">
          {% for warning in visualAudit.warnings %}
            <li>
              <h3 class="govuk-heading-s">{{ warning.title }}</h3>
              <p class="dpr-audit-description">{{ warning.description }}</p>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if visualAudit.suggestionCount %}
        <h2 class="govuk-heading-s">Suggestions</h2>
        <ul class="govuk-list">
          {% for suggestion in visualAudit.suggestions %}
            <li>
              <h3 class="govuk-heading-s">{{ suggestion.title }}</h3>
              <p class="dpr-audit-description">{{ suggestion.description }}</p>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      {% if visualAudit.infoCount %}
        <h2 class="govuk-heading-s">Info</h2>
        <ul class="govuk-list">
          {% for i in visualAudit.info %}
            <li>
              <h3 class="govuk-heading-s">{{ i.title }}</h3>
              <p class="dpr-audit-description">{{ i.description }}</p>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    {% endif %}

  </div>
{% endmacro %}
