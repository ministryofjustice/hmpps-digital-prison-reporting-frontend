{% from "./dashboard-audit-items/view.njk" import dprDashboardAuditItems %}
{% from "moj/components/notification-badge/macro.njk" import mojNotificationBadge %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% macro dprDashboardAudit(audit)  %}
    {% set classes = "dpr-dashboard-audit" %}
    {% set noIssuesFound = audit.totalCount === 0 %}

    {% if audit.warningCount > 0 %}
      {% set classes = "dpr-dashboard-audit dpr-dashboard-audit--warning" %}
    {% endif %}

    {% if audit.errorCount > 0 %}
      {% set classes = "dpr-dashboard-audit dpr-dashboard-audit--error" %}
    {% endif %}

    {% if noIssuesFound %}
      {% set classes = "dpr-dashboard-audit dpr-dashboard-audit--passed" %}
    {% endif %}

    {% set dashboardAuditHtml %}
      <div
        aria-labelledby="dpr-dashboard-audit">

        <h1 id="dpr-dashboard-audit" class="govuk-heading-l govuk-visually-hidden">Dashboard audit</h2>

        {% if audit.totalCount === 0 %}
          <p class="govuk-body dpr-audit-no-issues">No issues found</p>
        {% endif %}

        {% if audit.errorCount %}
          {{ dprDashboardAuditItems('Errors', audit.errorCount, audit.errors) }}
        {% endif %}

        {% if audit.warningCount %}
          {{ dprDashboardAuditItems('Warnings', audit.warningCount, audit.warnings) }}
        {% endif %}

        {% if audit.suggestionCount %}
          {{ dprDashboardAuditItems('Suggestions', audit.suggestionCount, audit.suggestions) }}
        {% endif %}

        {{ dprDashboardAuditItems('Info', audit.infoCount, audit.info) }}

      </div>
    {% endset %}

    {{
      govukDetails({
        summaryText: 'Dashboard audit',
        html: dashboardAuditHtml,
        open: true,
        classes: classes
      })
    }}
{% endmacro %}
