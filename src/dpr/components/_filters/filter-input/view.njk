{% from "../../_inputs/autocomplete-text-input/view.njk" import dprAutocompleteTextInput -%}
{% from "../../_inputs/date-range/view.njk" import dprDateRange -%}
{% from "../../_inputs/granular-date-range/view.njk" import dprGranularDateRange -%}
{% from "../../_inputs/date-input/view.njk" import dprDate %}
{% from "../../_inputs/multi-select/view.njk" import dprMultiSelect %}
{% from "../../_inputs/autocomplete-multi/view.njk" import dprAutocompleteMulti %}
{% from "../../_inputs/text-input/view.njk" import dprTextInput %}
{% from "../../_inputs/radio-input/view.njk" import dprRadioInput %}
{% from "../../_inputs/select-input/view.njk" import dprSelectInput %}

{% macro dprFilterInput(filter, validationErrors, parameterPrefix) %}
  {% set filterType = filter.type | lower %}

  <div id="dpr_filter-wrapper_{{ id }}" class="dpr-filter-item">
    {%- if filterType === 'select' %}

      {{ dprMultiSelect(filter, validationErrors, parameterPrefix, mandatory) }}

    {%- elif filterType === 'multiselect' %}

      {{ dprMultiSelect(filter, validationErrors, parameterPrefix, mandatory) }}

    {% elif filterType === 'radio' %}

      {{ dprRadioInput(filter, validationErrors, parameterPrefix, mandatory)  }}

    {% elif filterType === 'date' %}

      {{ dprDate(filter, validationErrors) }}

    {% elif filterType === 'daterange' %}

      <div class="govuk-form-group govuk-!-margin-bottom-0">
        {{ dprDateRange(filter, validationErrors, parameterPrefix, mandatory) }}
      </div>

    {% elif filterType === 'granulardaterange' %}

      <div class="govuk-form-group">
        {{ dprGranularDateRange(filter, validationErrors, parameterPrefix, mandatory) }}
      </div>

    {% elif filterType === 'autocomplete' %}

      {{ dprAutocompleteTextInput(filter, validationErrors, parameterPrefix, mandatory) }}

    {% elif filterType === 'text' %}

      {{ dprTextInput(filter, validationErrors, parameterPrefix, mandatory) }}

    {% elif filterType === 'autocompletemulti' %}

      {{ dprAutocompleteMulti(filter, validationErrors, parameterPrefix, mandatory) }}

    {% endif %}
  </div>
{% endmacro %}
