{% from "govuk/components/input/macro.njk" import govukInput %}

{% macro dprAutocompleteTextInput(filter, validationErrors, parameterPrefix, mandatory) %}

  {% set id = parameterPrefix + filter.name %}
  {% set name = id %}
  {% set value = filter.value %}
  {% set items = filter.options %}
  {% set staticOptionNameValue = filter.staticOptionNameValue %}
  {% set pattern = filter.pattern or '.+'  %}
  {% set labelText = filter.text | capitaliseSentence %}
  {% set minimumLength = filter.minimumLength %}
  {% set dynamicResourceEndpoint = filter.dynamicResourceEndpoint %}
  {% set listId = (id | replace(".", "")) + "-list" %}
  {% set labelInputName = 'label.' + filter.name %}
  {% set hint = filter.hint %}

  {% set inputAttributes = {
    "role": "combobox",
    "aria-autocomplete": "list",
    "aria-expanded": "false",
    "aria-controls": listId,
    "aria-haspopup": "listbox",
    "data-minimum-length": minimumLength,
    "placeholder": "Search",
    "pattern": pattern,
    "required": "true" if mandatory
  } %}

  <div
    class="dpr-autocomplete-text-input"
    data-dpr-module="autocomplete-text-input"
  >

    <input
      type="hidden"
      name="{{ name }}"
      value="{{ staticOptionNameValue }}"
      data-autocomplete-hidden
    />

    {{
      govukInput({
        id: id,
        label: {
          text: labelText,
          classes: "govuk-!-font-weight-bold dpr-inline-label"
        },
        name: labelInputName,
        value: value,
        type: "text",
        autocomplete: "off",
        errorMessage: validationErrors | dpr.findError(id),
        classes: "autocomplete-text-input-box govuk-input--width-20",
        attributes: inputAttributes,
        suffix: {
          html: "&#x1F50D;"
        },
        hint: {
          html: hint
        }
      })
    }}

    <div class="autocomplete-text-input-list-container">
      <ul
        id="{{ listId }}"
        class="autocomplete-text-input-list autocomplete-text-input-list--hidden"
        role="listbox"
        aria-label="{{ labelText }}"
      >

        {% for item in items %}
          <li
            id="{{ listId }}-{{ loop.index0 }}"
            role="option"
            aria-selected="false"
            class="autocomplete-option autocomplete-text-input-item-hide"
            data-value="{{ item.value }}"
            data-display="{{ item.text }}"
          >
            {{ item.text }}
          </li>
        {% endfor %}

      </ul>
    </div>

  </div>

{% endmacro %}
