{% from "govuk/components/input/macro.njk" import govukInput %}
{%- from "moj/components/date-picker/macro.njk" import mojDatePicker -%}
{% from "../date-input/minMaxToggle/view.njk" import dprDateMinMaxToggle %}

{% macro dprDate(filter, validationErrors, parameterPrefix, mandatory, type) %}

  {% set name = filter.name %}
  {% set text = filter.text %}
  {% set minDate = filter.min %}
  {% set maxDate  = filter.max %}

  {% set defaultMinDate = '1977-05-25' %}
  {% set defaultMaxDate = '9999-01-01' %}

  {% if type and type === 'start' %}

    {% set id = parameterPrefix + name + '.' + type %}
    {% set displayName = text + ' ' + type  %}
    {% set value = filter.value.start %}
    {% set label = 'From' %}
    {% set toggleMin = true %}
    {% set toggleMax = false %}

  {% elif type and type === 'end' %}

    {% set id = parameterPrefix + name + '.' + type %}
    {% set displayName = text + ' ' + type  %}
    {% set value = filter.value.end %}
    {% set label = 'To' %}
    {% set toggleMin = false %}
    {% set toggleMax = true %}

  {% else %}

    {% set id = parameterPrefix + name %}
    {% set displayName = text  %}
    {% set value = filter.value %}
    {% set toggleMin = true %}
    {% set toggleMax = true %}

  {% endif %}

  {% if value %}
    {% set value = value | dprDate %}
  {% endif %}

  <div
    class="dpr-date"
    data-dpr-module="date-input"
    data-required="{{ mandatory }}"
    data-display-name="{{ displayName }}"
    data-pattern="\d{1,2}\/\d{1,2}\/\d{2,4}"
    data-min="{{ minDate }}"
    data-max="{{ maxDate }}"
    data-pattern-hint="DD/MM/YYYY"
  >
    {% if text and type is undefined  %}
      <label class="govuk-label govuk-label govuk-!-font-weight-bold" for="{{ id }}"> {{ text }} </label>
    {% endif %}

    {{
      mojDatePicker({
        id: id,
        name: id,
        label: {
          text: label | capitaliseSentence
        } if label,
        value: value,
        minDate: minDate | dprDate,
        maxDate: maxDate | dprDate,
        hint: {
          text: "For example 17/05/2024."
        },
        errorMessage: validationErrors | dpr.findError(id)
      })
    }}

    {{ dprDateMinMaxToggle(minDate, maxDate, toggleMin, toggleMax, name, id) }}
  </div>
{% endmacro %}
