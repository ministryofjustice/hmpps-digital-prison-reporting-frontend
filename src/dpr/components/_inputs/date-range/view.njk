{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "../start-end-date/view.njk" import dprStartEndDate %}

{% macro dprDateRange(filter, validationErrors, parameterPrefix, mandatory) %}

  {% set name = filter.name %}
  {% set id = parameterPrefix + name %}
  {% set durationInputId = id + '.relative-duration' %}
  {% set value = filter.value %}
  {% set relativeValue = value.relative %}
  {% set relativeOptions = filter.relativeOptions %}
  {% set text = filter.text %}
  {% set hint = filter.hint %}

  <div class="dpr-date-range" data-dpr-module="date-range-input">
    <fieldset class="govuk-fieldset">
      <legend class="govuk-fieldset__legend govuk-label govuk-!-font-weight-bold">{{ text }}</legend>
      {% if hint %}
        <div class="govuk-hint">{{ hint | safe }}</div>
      {% endif %}

      {% set relativeRangeHtml %}
        {{
          govukRadios({
            classes: 'govuk-radios--small',
            id: durationInputId,
            name: durationInputId,
            fieldset: {
              legend: {
                text: 'Preset date range',
                classes: "govuk-label govuk-!-font-weight-bold"
              }
            },
            formGroup: {
              classes: "govuk-!-margin-bottom-3 dpr-relative-range-radio"
            },
            items: relativeOptions,
            value: relativeValue,
            attributes: {
              'display-name': 'Preset date range'
            }
          })
        }}
      {% endset -%}

      {% set datepickerHtml %}
        <div id="dpr-date-range" data-field-name="{{ name }}">
          {{ dprStartEndDate(filter, validationErrors, parameterPrefix, mandatory) }}
        </div>
      {% endset %}


      {% if relativeOptions === undefined or relativeOptions.length === 0 %}

        {{ datepickerHtml | safe }}

      {% else %}

        {{
          govukTabs({
            items: [
              {
                label: "Date range",
                id: name + "-date-picker",
                panel: {
                  html: datepickerHtml
                }
              },
              {
                label: "Preset date ranges",
                id: name + "-relative-range",
                panel: {
                  html: relativeRangeHtml
                }
              }
            ]
          })
        }}
      {% endif %}
    </fieldset>
  </div>
{% endmacro %}
