{% from "../date-input/view.njk" import dprDate %}

{% macro dprStartEndDate(filter, validationErrors, parameterPrefix, mandatory) %}
  <div class="dpr-daterange__start-end-date-wrapper">
    {# START #}
    <div class="dpr-daterange__start-date">
      {{ dprDate(filter, validationErrors, parameterPrefix, mandatory, 'start') }}
    </div>

    {# END #}
    <div class="dpr-daterange__end-date">
      {{ dprDate(filter, validationErrors, parameterPrefix, mandatory, 'end') }}
    </div>
  </div>
{% endmacro %}
