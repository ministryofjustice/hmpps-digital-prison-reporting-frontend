{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro dprReportsCatalogueCollections(collectionsConfig) %}

  {% set csrfToken = collectionsConfig.csrfToken %}
  {% set currentUrl = collectionsConfig.currentUrl %}
  {% set productCollections = collectionsConfig.productCollections %}
  {% set selectedProductCollection = collectionsConfig.selectedProductCollection %}
  {% set formAction = collectionsConfig.formAction %}

  {% if productCollections.length > 0 %}
    <div class="dpr-reports-catalogue-collection">
      <form method="post" action="{{ formAction }}">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <input type="hidden" name="returnTo" value="{{ currentUrl }}" />

        <div class="dpr-reports-catalogue-collection__controls">
          {{
            govukSelect({
              id: 'productCollection',
              name: 'productCollection',
              value: selectedProductCollection.id,
              items: productCollections,
              label: {
                text: 'Your collections',
                classes: "govuk-label govuk-!-font-weight-bold govuk-!-margin-bottom-2 dpr-reports-catalogue-collection__select"
              }
            })
          }}

          {{
            govukButton({
              text: 'Apply collection',
              classes: "govuk-button--primary dpr-reports-catalogue-collection__button"
            })
          }}
        </div>
      </form>
    </div>
  {% endif %}
{% endmacro %}
