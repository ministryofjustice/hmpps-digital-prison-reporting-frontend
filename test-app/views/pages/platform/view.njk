{% extends "views/page.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "components/catalogue/view.njk" import dprReportsCatalogue %}
{% from "components/my-reports/view.njk" import dprMyReports %}

{% block content %}
  <div class="govuk-width-container">
    {% set rows = [] %}
    {% if (breadCrumbList.length > 0) %}
      {% set rows = rows.concat(breadCrumbList) %}
    {% endif %}
    {%
      set rows = rows.concat([
        {
          text: title
        }
      ])
    %}

    {% if title !== 'Home' %}
      <div class="govuk-!-margin-bottom-4">
        {{
          govukBreadcrumbs({
            collapseOnMobile: true,
            items: rows,
            classes: "govuk-!-display-none-print hmpps-header__container"
          })
        }}
      </div>
    {% endif %}

    <h1 class="govuk-heading-l">{{ title }}</h1>

    <a href="http://localhost:3010/dpr/request-report/report/request-examples/request-example-success/internal">Internal report link</a>

    <h2 class="govuk-heading-m">My Reports</h2>
    {{ dprMyReports(myReportsData) }}

    {{ dprReportsCatalogue(catalogue) }}

  </div>
{% endblock %}
